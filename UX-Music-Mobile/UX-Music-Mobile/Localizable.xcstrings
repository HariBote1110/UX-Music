      }
    },
    "In automatic mode, hosts are tried from the top until one responds, and the successful host is remembered as the preferred target.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In automatic mode, hosts are tried from the top until one responds, and the successful host is remembered as the preferred target."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動モードでは上から順に到達できるホストを探し、成功したホストを優先接続先として記憶します。"
          }
        }
      }
    },
    "In fixed mode, only the selected host is used — there is no automatic fallback to other candidates on failure.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In fixed mode, only the selected host is used — there is no automatic fallback to other candidates on failure."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "固定モードでは選んだホストにのみ接続し、失敗しても他の候補への自動切り替えは行いません。"
          }
        }
      }
    },
