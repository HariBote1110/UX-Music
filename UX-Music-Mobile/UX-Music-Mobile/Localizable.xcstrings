{
  "sourceLanguage": "en",
  "strings": {
    "AAC (Small)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AAC (Small)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AAC (小容量)"
          }
        }
      }
    },
    "AAC is about 1/7 the size, so transfers to Apple Watch are faster. With “Full + AAC”, playback uses full quality while Watch transfers use AAC. This does not apply retroactively to songs already downloaded.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AAC is about 1/7 the size, so transfers to Apple Watch are faster. With “Full + AAC”, playback uses full quality while Watch transfers use AAC. This does not apply retroactively to songs already downloaded."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AAC は約 1/7 のサイズで Apple Watch への転送が速いです。「フル + AAC」なら再生はフル音質、Watch 転送には AAC が使われます。既にダウンロード済みの曲には遡って適用されません。"
          }
        }
      }
    },
    "APPLE WATCH": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "APPLE WATCH"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "APPLE WATCH"
          }
        }
      }
    },
    "Aim at the QR code in UX Music → Settings on your desktop.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aim at the QR code in UX Music → Settings on your desktop."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デスクトップの UX Music → 設定 にある QR コードにカメラを向けてください。"
          }
        }
      }
    },
