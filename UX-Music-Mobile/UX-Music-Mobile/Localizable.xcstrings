    "Keep the Watch app open on your wrist while transferring — for long batches, extend Settings > General > Return to Clock for this app to Custom (1 Hour)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep the Watch app open on your wrist while transferring — for long batches, extend Settings > General > Return to Clock for this app to Custom (1 Hour)."
