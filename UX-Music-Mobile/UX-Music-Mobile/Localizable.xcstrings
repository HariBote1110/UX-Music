{
  "sourceLanguage" : "en",
  "strings" : {
    "\"Omit\" adds only the songs already on this device, in order. \"Download\" fetches the missing ones from the desktop first, in the same order, then adds them (songs that fail to download are skipped)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Omit\" adds only the songs already on this device, in order. \"Download\" fetches the missing ones from the desktop first, in the same order, then adds them (songs that fail to download are skipped)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「除く」は端末にある曲だけを並び順どおりに追加します。「ダウンロード」は不足分をデスクトップから順に取得してから同じ順で追加します（取得に失敗した曲はスキップされます）。"
          }
        }
      }
    },
